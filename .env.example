# Server
HOST=127.0.0.1
PORT=5678
# Where SQLite, encrypted credentials and reports live
DATA_DIR=

# Master secret for encrypting credentials at rest.
# If empty, a key is generated into data/.master.key on first use.
WORKFLOW_SECRET=

# Collection runners used by qa.runCollection
# Newman is preferred: it needs no login. Install: npm i -g newman
NEWMAN_BIN=newman
POSTMAN_BIN=postman

# AI (OpenAI-compatible API). Can also be configured as a credential in the UI.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# opencode CLI provider (uses your local opencode login/models; no API key here).
# Paid DeepSeek V4.1 via OpenCode Go. Free alternative: opencode/deepseek-v4.1-flash-free
OPENCODE_BIN=
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_AGENT=
OPENCODE_CWD=

# Official DeepSeek API (OpenAI-compatible). Models: deepseek-flash (V4.1), deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OpenAI / GPT (also works for any OpenAI-compatible gateway).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (native Messages API).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
