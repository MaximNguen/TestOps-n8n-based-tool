{
  "name": "QA: test results -> summary -> report -> file",
  "description": "Webhook receives autotest results, the engine summarizes likely problems, renders a report and saves it locally.",
  "active": true,
  "nodes": [
    {
      "id": "trigger-results",
      "type": "trigger.testResults",
      "name": "Test results webhook",
      "position": { "x": 80, "y": 180 },
      "parameters": {
        "path": "qa/test-results",
        "method": "POST",
        "source": "auto",
        "sample": {
          "results": [
            { "name": "GET /health", "method": "GET", "url": "https://api.demo.local/health", "status": 200, "passed": true, "duration": 42 },
            { "name": "GET /users", "method": "GET", "url": "https://api.demo.local/users", "status": 500, "passed": false, "error": "Internal Server Error" },
            { "name": "POST /auth/login", "method": "POST", "url": "https://api.demo.local/auth/login", "status": 401, "passed": false, "error": "Unauthorized: token expired" },
            { "name": "GET /orders/42", "method": "GET", "url": "https://api.demo.local/orders/42", "status": 404, "passed": false, "error": "Not Found" },
            { "name": "POST /payments", "method": "POST", "url": "https://api.demo.local/payments", "status": null, "passed": false, "error": "ETIMEDOUT: request timed out after 30000ms" },
            { "name": "GET /products", "method": "GET", "url": "https://api.demo.local/products", "status": 200, "passed": false, "error": "Schema mismatch: required field 'price' is missing" }
          ]
        }
      }
    },
    {
      "id": "summarize",
      "type": "ai.summarizeResults",
      "name": "AI summary",
      "position": { "x": 400, "y": 180 },
      "parameters": {
        "useAi": true,
        "language": "ru",
        "provider": "opencode",
        "credentialId": "",
        "baseUrl": "",
        "model": "opencode-go/deepseek-v4.1-flash",
        "agent": "",
        "opencodeBin": ""
      }
    },
    {
      "id": "report",
      "type": "qa.report",
      "name": "Build report",
      "position": { "x": 720, "y": 180 },
      "parameters": {
        "title": "QA report: autotest results"
      }
    },
    {
      "id": "publish-file",
      "type": "qa.publish",
      "name": "Save report",
      "position": { "x": 1040, "y": 180 },
      "parameters": {
        "channel": "file",
        "path": "",
        "title": ""
      }
    }
  ],
  "connections": [
    { "from": "trigger-results", "to": "summarize", "output": "main" },
    { "from": "summarize", "to": "report", "output": "main" },
    { "from": "report", "to": "publish-file", "output": "main" }
  ]
}
