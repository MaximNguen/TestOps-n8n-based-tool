{
  "name": "QA: OpenAPI -> test plan -> report",
  "description": "Manual run: generate API cases from an OpenAPI spec, build a test plan and render a report. Add qa.runCollection to execute them.",
  "active": true,
  "nodes": [
    {
      "id": "trigger-manual",
      "type": "trigger.manual",
      "name": "Manual trigger",
      "position": { "x": 80, "y": 200 },
      "parameters": { "sample": "" }
    },
    {
      "id": "openapi",
      "type": "qa.openapiCases",
      "name": "OpenAPI cases",
      "position": { "x": 380, "y": 200 },
      "parameters": {
        "specUrl": "",
        "baseUrl": "https://api.demo.local",
        "include": "",
        "maxCases": 20,
        "includeDeprecated": false,
        "spec": {
          "openapi": "3.0.0",
          "info": { "title": "Demo API", "version": "1.0.0" },
          "paths": {
            "/users": {
              "get": {
                "operationId": "listUsers",
                "summary": "List users",
                "parameters": [
                  { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
                ],
                "responses": { "200": { "description": "ok" } }
              },
              "post": {
                "operationId": "createUser",
                "summary": "Create user",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "required": ["name", "email"],
                        "properties": {
                          "name": { "type": "string", "example": "Ivan" },
                          "email": { "type": "string", "format": "email" }
                        }
                      }
                    }
                  }
                },
                "responses": { "201": { "description": "created" }, "400": { "description": "bad request" } }
              }
            },
            "/users/{id}": {
              "get": {
                "operationId": "getUser",
                "summary": "Get user by id",
                "parameters": [
                  { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 42 } }
                ],
                "responses": { "200": { "description": "ok" }, "404": { "description": "not found" } }
              },
              "delete": {
                "operationId": "deleteUser",
                "summary": "Delete user",
                "parameters": [
                  { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 42 } }
                ],
                "responses": { "204": { "description": "deleted" } }
              }
            }
          }
        }
      }
    },
    {
      "id": "plan",
      "type": "qa.testPlan",
      "name": "Test plan",
      "position": { "x": 700, "y": 200 },
      "parameters": {
        "mode": "template",
        "title": "Demo API test plan",
        "requirements": "Check CRUD for users, validation and error codes.",
        "maxCases": 20,
        "credentialId": "",
        "baseUrl": "",
        "model": "",
        "fallbackToTemplate": true
      }
    },
    {
      "id": "report",
      "type": "qa.report",
      "name": "Build report",
      "position": { "x": 1020, "y": 200 },
      "parameters": { "title": "Demo API test plan report" }
    },
    {
      "id": "publish-file",
      "type": "qa.publish",
      "name": "Save report",
      "position": { "x": 1340, "y": 200 },
      "parameters": { "channel": "file", "path": "", "title": "" }
    }
  ],
  "connections": [
    { "from": "trigger-manual", "to": "openapi", "output": "main" },
    { "from": "openapi", "to": "plan", "output": "main" },
    { "from": "plan", "to": "report", "output": "main" },
    { "from": "report", "to": "publish-file", "output": "main" }
  ]
}
