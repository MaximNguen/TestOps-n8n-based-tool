{
  "name": "QA engine: receive results",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qa-trigger",
        "options": {}
      },
      "id": "b1f0a8c6-1111-4a11-8a11-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "b1f0a8c6-1111-4a11-8a11-111111111111"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5678/webhook/qa/test-results",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body ?? $json) }}",
        "options": {}
      },
      "id": "b1f0a8c6-2222-4a11-8a11-222222222222",
      "name": "Call custom-n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "b1f0a8c6-3333-4a11-8a11-333333333333",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Call custom-n8n", "type": "main", "index": 0 }]]
    },
    "Call custom-n8n": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
